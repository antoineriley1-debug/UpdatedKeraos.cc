# =============================================================
# REQUIRED — Smartsheet
# =============================================================
SMARTSHEET_TOKEN=
SMARTSHEET_SHEET_ID=8870685098069892

# =============================================================
# REQUIRED — Auth
# =============================================================
# Used to sign session cookies. Must be at least 16 chars.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=

# User list — JSON array. Generate entries with: npm run add-user
# Example with one user:
# USERS=[{"email":"antoine.riley@crothall.com","name":"Antoine Riley","role":"admin","passwordHash":"abc123:def456..."}]
USERS=[]

# =============================================================
# Optional UI tuning
# =============================================================
NEXT_PUBLIC_DISPLAY_NAME=Priority Tasks
NEXT_PUBLIC_POLL_INTERVAL_MS=60000
